---
import arrow from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import down from '@phosphor-icons/core/assets/regular/arrow-down.svg?raw';
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
import close from '@phosphor-icons/core/assets/regular/x.svg?raw';
import flame from '@phosphor-icons/core/assets/regular/flame.svg?raw';
import search from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import bag from '@phosphor-icons/core/assets/regular/bag.svg?raw';
import back from "@phosphor-icons/core/assets/regular/arrow-left.svg?raw";
import phone from "@phosphor-icons/core/assets/regular/phone.svg?raw";
import minus from "@phosphor-icons/core/assets/regular/minus.svg?raw";
import zoom from "@phosphor-icons/core/assets/regular/magnifying-glass-plus.svg?raw";
import menu from "@phosphor-icons/core/assets/regular/list.svg?raw";
import whatsapp from "@phosphor-icons/core/assets/regular/whatsapp-logo.svg?raw";
import navigation from "@phosphor-icons/core/assets/regular/navigation-arrow.svg?raw";
const icons={whatsapp,navigation,back,phone,minus,zoom,menu,arrow,down,plus,check,close,flame,search,bag};
const {name='arrow',class:className=''}=Astro.props;
---
<span class:list={['ph-icon',className]} aria-hidden="true" set:html={icons[name as keyof typeof icons] || arrow}/>
