---
import Icon from './Icon.astro';
const {product,large=false}=Astro.props;
---
{product.image ? <img class:list={['product-image',{large}]} src={product.image} alt={product.name} loading="lazy" referrerpolicy="no-referrer"/> : <div class="product-image no-photo"><Icon name="bag"/><span>Fotografia não disponível no Uber Eats</span></div>}
