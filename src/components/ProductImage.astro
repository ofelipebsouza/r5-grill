---
const {product,large=false}=Astro.props;
const i=product.i;
---
<svg class:list={['product-image',{large}]} viewBox={`${(i%4)*313.5} ${[0,290,580,880][Math.floor(i/4)]} 313.5 ${i>=12?374:290}`} role="img" aria-label={`Imagem ilustrativa de ${product.name}`}><image href="/images/pratos.webp" width="1254" height="1254"/></svg>
