---
import Icon from './Icon.astro';
const {product,large=false}=Astro.props;
const packshot=product.imageKind!=="illustrative" && (product.category.startsWith("Bebidas") || ["Cerveja","Vinhos"].includes(product.category));
---
{product.image ? <img class:list={['product-image',{large,packshot}]} src={product.image} srcset={product.imageKind==="reference" ? `${product.image.replace(".webp","-600.webp")} 600w, ${product.image} 1200w` : undefined} sizes={product.imageKind==="reference" ? (large ? "(max-width: 900px) 88vw, 52vw" : "(max-width: 560px) 88vw, (max-width: 1050px) 44vw, 30vw") : undefined} alt={product.imageKind==="reference" ? `Imagem ilustrativa de ${product.name} recriada com IA a partir do cardápio` : product.imageKind==="illustrative" ? `Imagem ilustrativa de ${product.name}` : product.name} loading="lazy" referrerpolicy="no-referrer"/> : <div class="product-image no-photo"><Icon name="bag"/><span>Fotografia ainda não disponível</span></div>}
