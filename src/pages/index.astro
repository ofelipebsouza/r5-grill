---
import '../styles/global.css';
const menu = [
['Picanha grelhada','Vaca','9,00','O clássico que sabe sempre bem.'],['Grelhada R5','Vaca','10,00','Uma combinação de grelhados para quem gosta de variedade.'],['Picanha Gold','Vaca','13,00','A escolha para uma refeição especial.'],['Bife da vazia','Vaca','10,50','Um clássico da nossa grelha.'],['Maminha ao alho','Vaca','8,00','Maminha com o sabor inconfundível do alho.'],['Bife de frango grelhado','Frango','8,00','Simples, grelhado e cheio de sabor.'],['Espetinho de frango com bacon','Frango','8,00','Frango e bacon na mesma espetada.'],['Secretos de porco','Porco','9,00','Para os apreciadores de um bom grelhado.'],['Costeletão de novilho','Vaca','12,50','Uma escolha com presença à mesa.'],['Salsicha toscana','Porco','7,00','O sabor brasileiro na sua pausa.'],['Entremeada','Porco','7,50','Um dos clássicos da ementa.'],['Espetada de salmão com bacon','Peixe','10,50','Uma combinação entre o mar e a grelha.'],['Peixe do dia','Peixe',null,'Pergunte-nos qual é o peixe de hoje.'],['Salada mista','Saladas','8,00','Uma opção fresca para a sua refeição.']];
const eats='https://www.ubereats.com/pt/store/r5-grill-st-antonio-cavaleiros/4ebZsXLmS3SEjUKn45eU6Q';
const maps='https://www.google.com/maps/search/?api=1&query=R5+Grill+Continente+Loures+Quinta+Casal+da+Pipa';
---
<!doctype html><html lang="pt-PT"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>R5 Grill — Grelhados com alma, em Loures</title><meta name="description" content="Conheça a ementa do R5 Grill no Centro Comercial Continente de Loures. Picanha, grelhados, frango e peixe. Veja os pratos, contacte e peça no Uber Eats."/><meta name="theme-color" content="#b9222b"/><link rel="icon" href="/logo.svg" type="image/svg+xml"/><meta property="og:title" content="R5 Grill • Grelhados com alma"/><meta property="og:description" content="A sua próxima pausa tem sabor. Conheça a ementa em Loures."/><meta property="og:image" content="/images/picanha.webp"/></head><body>
<a class="skip" href="#main">Saltar para o conteúdo</a><div class="topline">SABORES DO BRASIL. À MESA EM PORTUGAL. <span>LOURES · CONTINENTE · LOJA 61</span></div>
<header><a href="/" class="brand" aria-label="R5 Grill início"><img src="/logo.svg" alt="R5 Grill" width="70" height="70"/><span>R5 GRILL<small>GRELHADOS COM ALMA</small></span></a><nav aria-label="Navegação principal"><a href="#ementa">A ementa</a><a href="#casa">A nossa casa</a><a href="#visita">Onde estamos</a></nav><a class="button small" href={eats} target="_blank" rel="noopener">Pedir online <span>↗</span></a></header>
<main id="main"><section class="hero"><img src="/images/picanha.webp" class="hero-photo" alt="Composição ilustrativa de picanha grelhada com arroz, feijão e batatas" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-copy"><p class="eyebrow">R5 GRILL / LOURES, PORTUGAL</p><h1>A fome passa.<br/>O sabor <em>fica.</em></h1><p>Da picanha aos seus grelhados favoritos.<br/>Sabor brasileiro, encontro marcado em Loures.</p><div class="actions"><a class="button" href="#ementa">Descobrir a ementa <span>↓</span></a><a class="text-link" href={eats} target="_blank" rel="noopener">Pedir no Uber Eats ↗</a></div><div class="hero-bottom"><span>BOA COMIDA.<br/><strong>BOA PAUSA.</strong></span><span>PARA COMER AQUI<br/>OU LEVAR CONSIGO.</span></div></div><span class="image-note">Imagem ilustrativa</span><div class="stamp">SABOR<br/><b>R5</b><br/>À GRANDE</div></section>
<div class="ticker" aria-hidden="true"><div>PICANHA &nbsp; ✦ &nbsp; GRELHADOS &nbsp; ✦ &nbsp; BOA COMPANHIA &nbsp; ✦ &nbsp; R5 GRILL &nbsp; ✦ &nbsp; PICANHA &nbsp; ✦ &nbsp; GRELHADOS &nbsp; ✦ &nbsp; BOA COMPANHIA &nbsp; ✦ &nbsp; R5 GRILL &nbsp; ✦ &nbsp;</div></div>
<section id="ementa" class="section"><div class="section-head"><div><p class="eyebrow red">ESCOLHA O SEU FAVORITO</p><h2>É tudo uma questão<br/>de <em>bom gosto.</em></h2></div><p>Carne, frango, peixe ou uma opção fresca.<br/>Explore os pratos da nossa ementa.</p></div><div class="filters" role="group" aria-label="Filtrar ementa">{['Todos','Vaca','Frango','Porco','Peixe','Saladas'].map((c)=><button data-filter={c} aria-pressed={c==='Todos'}>{c}</button>)}<label class="search"><span class="sr-only">Pesquisar pratos</span><input type="search" placeholder="O que lhe apetece?" id="search"/></label></div><p class="menu-note">Preços da ementa fotografada. Confirme os valores e a disponibilidade com o restaurante; os preços de entrega podem ser diferentes.</p><div class="menu-grid">{menu.map(([name,cat,price,desc],i)=><article class="dish" data-category={cat} data-name={name?.toLowerCase()}><div class="dish-top"><span class="eyebrow">{cat}</span><span class="dish-number">{String(i+1).padStart(2,'0')}</span></div><h3>{name}</h3><p>{desc}</p><div class="dish-bottom"><strong>{price ? `${price} €`:'Sob consulta'}</strong><button class="add" data-product={name} aria-label={`Adicionar ${name} à seleção`}>+</button></div></article>)}</div><p id="empty" hidden>Nenhum prato encontrado. Experimente outra pesquisa.</p><div class="menu-footer"><p>A ementa fotografada indica bebida (copo) e café incluídos nos pratos.<br/><small>Para informações sobre alergénios, contacte o restaurante antes de pedir.</small></p><a href="/images/ementa.jpeg" target="_blank" class="text-link">Ver ementa original ↗</a></div></section>
<section id="casa" class="about"><img src="/images/restaurante.jpeg" alt="Fachada e espaço do R5 Grill no centro comercial" loading="lazy"/><div><p class="eyebrow">A SUA PAUSA EM LOURES</p><h2>Uma mesa.<br/>Muitos motivos<br/>para <em>voltar.</em></h2><p>Entre as compras e o resto do dia, há sempre espaço para uma boa refeição. Encontre-nos no Centro Comercial Continente de Loures e descubra os sabores da nossa grelha.</p><a class="button cream" href={maps} target="_blank" rel="noopener">Como chegar <span>↗</span></a></div></section>
<section id="visita" class="section visit"><div><p class="eyebrow red">VENHA COM APETITE</p><h2>O próximo encontro<br/>é <em>aqui.</em></h2><p>Centro Comercial Continente de Loures · Loja 61<br/>Quinta Casal da Pipa, EN 250<br/>2670-339 Loures, Portugal</p><a class="phone" href="tel:+351968299852">+351 968 299 852 ↗</a><small>Chamada para a rede móvel nacional.<br/>Confirme o horário e a disponibilidade por telefone.</small><div class="actions"><a class="button" href={eats} target="_blank" rel="noopener">Pedir no Uber Eats ↗</a><a class="text-link" href={maps} target="_blank" rel="noopener">Abrir mapa ↗</a></div></div><div class="location-card"><span>PORTUGAL / LOURES</span><b>R5<br/><em>GRILL</em></b><p>38° N · SABOR SEM PRESSA</p><a href={maps} target="_blank" rel="noopener">ENCONTRAR O RESTAURANTE ↗</a></div></section>
</main><footer><a class="brand" href="/">R5 GRILL</a><span>Grelhados com alma. Loures, Portugal.</span><div><a href="/marca">A marca</a><a href="/instagram">Kit Instagram</a><a href="/fontes">Informações</a></div></footer>
<button id="basket" class="basket" hidden>Ver seleção <span id="count">0</span></button><dialog id="order"><div class="dialog-head"><h2>A sua seleção</h2><button id="close" aria-label="Fechar seleção">×</button></div><p>Prepare a sua escolha. Confirme o pedido por telefone ou escolha os pratos no Uber Eats.</p><ul id="selected"></ul><p class="menu-note">A seleção não é enviada automaticamente ao restaurante.</p><button class="button" id="copy">Copiar seleção</button><a class="button dark" href="tel:+351968299852">Ligar ao restaurante</a><a class="text-link" href={eats} target="_blank" rel="noopener">Continuar no Uber Eats ↗</a><p id="feedback" role="status"></p></dialog>
<script>
const choices = new Map<string,number>();
const basket=document.querySelector<HTMLButtonElement>('#basket')!;
const dialog=document.querySelector<HTMLDialogElement>('#order')!;
let active='Todos';
function filter(){const q=(document.querySelector<HTMLInputElement>('#search')!.value).toLocaleLowerCase('pt');let visible=0;document.querySelectorAll<HTMLElement>('.dish').forEach(el=>{el.hidden=!((active==='Todos'||el.dataset.category===active)&&el.dataset.name!.includes(q));if(!el.hidden)visible++;});document.querySelector<HTMLElement>('#empty')!.hidden=visible>0;}
document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.addEventListener('click',()=>{active=b.dataset.filter!;document.querySelectorAll('[data-filter]').forEach(el=>el.setAttribute('aria-pressed',String(el===b)));filter();}));document.querySelector('#search')!.addEventListener('input',filter);
function render(){const list=document.querySelector('#selected')!;list.replaceChildren();let total=0;choices.forEach((n,name)=>{total+=n;const li=document.createElement('li');const text=document.createElement('span');text.textContent=`${n} × ${name}`;const b=document.createElement('button');b.textContent='Remover';b.setAttribute('aria-label',`Remover ${name}`);b.onclick=()=>{if(n>1)choices.set(name,n-1);else choices.delete(name);render();};li.append(text,b);list.append(li);});basket.hidden=total===0;document.querySelector('#count')!.textContent=String(total);}
document.querySelectorAll<HTMLButtonElement>('.add').forEach(b=>b.addEventListener('click',()=>{const name=b.dataset.product!;choices.set(name,(choices.get(name)||0)+1);render();b.textContent='✓';setTimeout(()=>b.textContent='+',700);}));basket.onclick=()=>dialog.showModal();document.querySelector<HTMLButtonElement>('#close')!.onclick=()=>dialog.close();document.querySelector<HTMLButtonElement>('#copy')!.onclick=async()=>{try{await navigator.clipboard.writeText('Olá! Gostaria de confirmar disponibilidade para:\n'+[...choices].map(([n,q])=>`${q} × ${n}`).join('\n'));document.querySelector('#feedback')!.textContent='Seleção copiada.';}catch{document.querySelector('#feedback')!.textContent='Não foi possível copiar. Pode consultar a seleção acima durante a chamada.';}};
</script></body></html>
