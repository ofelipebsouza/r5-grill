---
import '../../styles/global.css';
import {whatsappOrder} from '../../data/contact';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import ProductImage from '../../components/ProductImage.astro';
import {products,eats} from '../../data/menu';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product}=Astro.props;
const related=products.filter(p=>p.slug!==product.slug).sort((a,b)=>Number(b.category===product.category)-Number(a.category===product.category)).slice(0,3);
---
<!doctype html><html lang="pt-PT"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{product.name} — Ementa R5 Grill Loures</title><meta name="description" content={`${product.name} no R5 Grill de Loures. ${product.description} Conheça o prato e confirme o seu pedido.`}/><link rel="canonical" href={`https://r5-grill.vercel.app/pratos/${product.slug}/`}/><link rel="icon" href="/logo.svg"/><meta name="theme-color" content="#b9222b"/></head><body class="product-page"><a class="skip" href="#main">Saltar para o conteúdo</a><Header/><main id="main"><nav class="breadcrumbs" aria-label="Percurso"><a href="/#ementa"><Icon name="back"/> Ementa</a><span>/</span><span>{product.category}</span><span>/</span><span aria-current="page">{product.name}</span></nav>
<section class="product-hero"><div class="product-visual"><button id="zoom" aria-label={`Ampliar imagem de ${product.name}`}><ProductImage product={product} large/><span class="zoom-icon"><Icon name="zoom"/></span></button><p>{product.imageNote}</p></div><div class="product-info"><p class="eyebrow red">DA NOSSA EMENTA / {product.category}</p><h1>{product.name}</h1><p class="product-description">{product.description}</p>{product.rating && <p class="product-rating">Aprovação no Uber Eats: {product.rating} · 21/10/2026</p>}<div class="product-price"><strong>{product.price?`${product.price} €`:'Sob consulta'}</strong><span>Preço no Uber Eats · 21/10/2026</span></div><p class="product-disclaimer">Preço da plataforma; pode diferir do preço no restaurante. Confirme o total, as taxas e a disponibilidade no Uber Eats.</p>{product.volumeNote && <p class="product-disclaimer">{product.volumeNote}</p>}<div class="order-panel"><label for="quantity">Quantidade</label><div class="product-controls"><div class="stepper"><button id="decrease" aria-label="Diminuir quantidade"><Icon name="minus"/></button><input id="quantity" type="number" min="1" max="20" value="1" inputmode="numeric" aria-label="Quantidade de artigos"/><button id="increase" aria-label="Aumentar quantidade"><Icon name="plus"/></button></div><button id="add-product" class="button" data-name={product.name}><Icon name="bag"/> Adicionar à seleção</button></div><p id="added" role="status"></p><a href="/?selecao=1#ementa" class="selection-link">Ver a minha seleção <Icon name="arrow"/></a></div><div class="product-order-actions"><a id="product-whatsapp" data-name={product.name} class="button whatsapp" href={whatsappOrder([[product.name,1]])} target="_blank" rel="noopener"><Icon name="whatsapp"/> Pedir pelo WhatsApp</a><a class="button" href={product.url} target="_blank" rel="noopener">Pedir no Uber Eats <Icon name="arrow"/></a><a class="button outline" href="tel:+351968299852"><Icon name="phone"/> Ligar</a></div><small>A seleção ajuda a organizar a sua escolha. O pedido é confirmado diretamente com o restaurante ou na plataforma.</small><div class="product-faq"><details open><summary>O que acompanha o prato?</summary><p>{product.description}</p></details><details><summary>Como pedir no Uber Eats?</summary><p>Abra o Uber Eats, selecione o artigo e consulte as opções de acompanhamentos, bebida, entrega ou recolha. Os menus identificados na plataforma incluem três acompanhamentos e bebida. A seleção deste site não é transferida automaticamente.</p></details><details><summary>Alergénios e preferências</summary><p>Contacte o restaurante para confirmar ingredientes, alergénios e possíveis adaptações antes de encomendar.</p></details><details><summary>Onde encontrar o R5 Grill?</summary><p>Centro Comercial Continente de Loures, loja 61. Quinta Casal da Pipa, EN 250, 2670-339 Loures.</p><a href="/#visita">Ver localização</a></details></div></div></section>
<section class="section related"><div class="section-head"><div><p class="eyebrow red">CONTINUE A EXPLORAR</p><h2>Mais motivos para<br/><em>abrir o apetite.</em></h2></div><a class="text-link" href="/#ementa">Ver toda a ementa <Icon name="arrow"/></a></div><div class="related-grid">{related.map(p=><a class="related-card" href={`/pratos/${p.slug}/`}><div class="related-image"><ProductImage product={p}/><span>{p.imageKind === "illustrative" ? "Imagem ilustrativa" : "Imagem do Uber Eats"}</span></div><div><small>{p.category}</small><h3>{p.name}</h3><span>{p.price?`${p.price} €`:'Sob consulta'}</span><Icon name="arrow"/></div></a>)}</div></section></main><footer><a class="brand" href="/">R5 GRILL</a><span>Grelhados com alma. Loures, Portugal.</span><a href="/fontes">Informações e preços</a></footer><dialog id="photo-dialog" class="photo-dialog"><button id="close-photo" aria-label="Fechar imagem"><Icon name="close"/></button><ProductImage product={product} large/><p>{product.name} · {product.imageKind === "illustrative" ? "Imagem ilustrativa" : "Imagem do Uber Eats"}</p></dialog>
<script>
import {whatsappOrder} from "../../data/contact";
const qty=document.querySelector<HTMLInputElement>('#quantity')!;
function quantity(){const n=Number(qty.value);const safe=Number.isFinite(n)?Math.min(20,Math.max(1,Math.trunc(n))):1;qty.value=String(safe);return safe;}
document.querySelector<HTMLButtonElement>('#increase')!.onclick=()=>{qty.value=String(Math.min(20,quantity()+1));};document.querySelector<HTMLButtonElement>('#decrease')!.onclick=()=>{qty.value=String(Math.max(1,quantity()-1));};qty.addEventListener('change',quantity);
document.querySelector<HTMLButtonElement>('#add-product')!.onclick=(event)=>{const name=(event.currentTarget as HTMLButtonElement).dataset.name!;try{const data=JSON.parse(sessionStorage.getItem('r5-selection')||'[]');const valid=Array.isArray(data)?data.filter(v=>Array.isArray(v)&&typeof v[0]==='string'&&Number.isInteger(v[1])&&v[1]>0&&v[1]<=99):[];const selected=new Map<string,number>(valid);selected.set(name,Math.min(99,(selected.get(name)||0)+quantity()));sessionStorage.setItem('r5-selection',JSON.stringify([...selected]));document.querySelector('#added')!.textContent=`${quantity()} artigo(s) adicionada(s) à sua seleção.`;}catch{document.querySelector('#added')!.textContent='Não foi possível guardar a seleção neste navegador. Pode pedir por telefone ou no Uber Eats.';}};
const whatsapp=document.querySelector<HTMLAnchorElement>('#product-whatsapp')!;
whatsapp.addEventListener('click',()=>{whatsapp.href=whatsappOrder([[whatsapp.dataset.name!,quantity()]]);});
const photo=document.querySelector<HTMLDialogElement>('#photo-dialog')!;document.querySelector<HTMLButtonElement>('#zoom')!.onclick=()=>photo.showModal();document.querySelector<HTMLButtonElement>('#close-photo')!.onclick=()=>photo.close();
</script></body></html>
